{
  "name": "unity-publisher-analytics",
  "private": true,
  "scripts": {
    "test": "npm run test:fixtures && npm run test:sync && npm run test:isolation",
    "build:charts": "esbuild scripts/echarts-entry.js --bundle --minify --format=iife --global-name=echarts --outfile=vendor/echarts.min.js --legal-comments=linked",
    "capture:marketing": "node scripts/capture-marketing.mjs",
    "create:promos": "node scripts/create-promo-tiles.mjs",
    "test:fixtures": "node scripts/validate-api-fixtures.js",
    "test:isolation": "node scripts/validate-publisher-isolation.js",
    "test:sync": "node --test scripts/test-incremental-sync.js scripts/test-full-sync-recovery.js",
    "test:chrome-smoke": "node scripts/smoke-chrome.mjs",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "validate:packages": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-packages.ps1 -Target All",
    "package": "node scripts/run-package.mjs All",
    "package:chrome": "node scripts/run-package.mjs Chrome",
    "package:firefox": "node scripts/run-package.mjs Firefox"
  },
  "devDependencies": {
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3"
  }
}
