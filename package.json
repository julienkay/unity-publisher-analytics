{
  "name": "unity-publisher-analytics",
  "private": true,
  "scripts": {
    "build:charts": "esbuild scripts/echarts-entry.js --bundle --minify --format=iife --global-name=echarts --outfile=vendor/echarts.min.js --legal-comments=linked",
